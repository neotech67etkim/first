<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NavisTreeExporter</AssemblyName>
    <RootNamespace>NavisTreeExporter</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>

    <!--
      Path to the Navisworks Simulate installation that provides the API
      assemblies referenced below. Override on the command line or in a
      NavisTreeExporter.csproj.user file, e.g.:
        msbuild /p:NavisworksInstallDir="D:\Autodesk\Navisworks Simulate 2022\"
    -->
    <NavisworksInstallDir Condition="'$(NavisworksInstallDir)' == ''">C:\Program Files\Autodesk\Navisworks Simulate 2022\</NavisworksInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Provided by the Navisworks Simulate 2022 install; not redistributed with
      this add-in. Only Autodesk.Navisworks.Api is referenced because the
      current code (Core/Export/Plugin) only uses that namespace — the COM
      interop assemblies aren't needed unless COM-level APIs are added later.
    -->
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
